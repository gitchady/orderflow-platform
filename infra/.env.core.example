NGINX_PORT=8080
JWT_SECRET=replace-with-a-long-random-value

CATALOG_DB_NAME=catalog
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=replace-with-a-random-url-safe-value

ORDER_DB_NAME=orders
ORDER_DB_USER=orders
ORDER_DB_PASSWORD=replace-with-a-random-url-safe-value

PAYMENT_DB_NAME=payments
PAYMENT_DB_USER=payments
PAYMENT_DB_PASSWORD=replace-with-a-random-url-safe-value

AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=replace-with-a-random-url-safe-value

RABBITMQ_USER=orderflow
RABBITMQ_PASSWORD=replace-with-a-random-url-safe-value
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# For local-only access use 127.0.0.1. For separate servers use the core
# server's private IP in both variables and in analytic KAFKA_BOOTSTRAP_SERVERS.
KAFKA_EXTERNAL_HOST=127.0.0.1
KAFKA_BIND_HOST=127.0.0.1
